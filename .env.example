# n888n-prisma — variáveis de ambiente
# Copie para .env na raiz do projeto e preencha os valores reais.
# O .env é carregado automaticamente pelos agentes (python-dotenv).

# PostgreSQL local (banco de dados públicos prisma_data)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=prisma_data
DB_USER=postgres
DB_PASSWORD=
